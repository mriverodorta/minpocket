# Source-only repository. New top-level directories require review.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/THIRD_PARTY.md
!/Makefile
!/native/
!/boot/
!/design/
!/production/
!/scripts/
!/.github/
!/.githooks/
# Credentials and personal provisioning, at every directory depth.
**/.env
**/.env.*
**/*.env
**/*.env.*
**/*credentials*
**/*secret*
**/authorized_keys
**/known_hosts
**/id_rsa*
**/id_ed25519*
**/*.pem
**/*.key
**/localdev/
**/provisioning/
**/research/
**/experiments/
**/concepts/
**/screenshots/
**/games/
**/.DS_Store
**/__pycache__/
**/*.pyc
# No images, recordings, disk images, caches, binaries or build archives.
**/*.png
**/*.jpg
**/*.jpeg
**/*.bmp
**/*.gif
**/*.webp
**/*.avif
**/*.svg
**/*.mp4
**/*.img
**/*.fit
**/*.dtb
**/*.cpio*
**/*.tar*
**/*.zip
**/*.gz
**/*.xz
**/*.mps
**/*.mpa
**/*.rgba
**/*.o
**/*.so*
**/*.dylib
**/*.a
**/*.log
**/*.dSYM/
